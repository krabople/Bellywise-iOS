{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": [
      "node",
      "react"
    ]
  },
  "include": ["App.tsx", "index.ts", "src/**/*.ts", "src/**/*.tsx", "modules/**/*.ts", "modules/**/*.tsx", "tests/**/*.ts"],
  "exclude": ["node_modules", ".expo", "dist", "dist-ios", "dist-web", "coverage", "ios", "android"]
}
