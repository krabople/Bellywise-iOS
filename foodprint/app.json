{
  "expo": {
    "name": "Bellywise",
    "slug": "bellywise",
    "version": "1.1.0",
    "scheme": "bellywise",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.krabople.bellywise",
      "buildNumber": "1",
      "appleTeamId": "6YYA8L76Y8",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Scan product barcodes and photograph ingredient lists so Bellywise can help you log food and drinks.",
        "NSPhotoLibraryUsageDescription": "Choose an ingredient-label photo to read privately on this device.",
        "CFBundleLocalizations": [
          "ar",
          "bn",
          "ca",
          "zh-Hans",
          "zh-Hant",
          "hr",
          "cs",
          "da",
          "nl",
          "en-AU",
          "en-CA",
          "en-GB",
          "en-US",
          "fi",
          "fr",
          "fr-CA",
          "de",
          "el",
          "gu",
          "he",
          "hi",
          "hu",
          "id",
          "it",
          "ja",
          "kn",
          "ko",
          "ms",
          "ml",
          "mr",
          "nb",
          "or",
          "pl",
          "pt-BR",
          "pt-PT",
          "pa",
          "ro",
          "ru",
          "sk",
          "sl",
          "es-MX",
          "es-ES",
          "sv",
          "ta",
          "te",
          "th",
          "tr",
          "uk",
          "ur",
          "vi"
        ],
        "CFBundleDevelopmentRegion": "en-GB"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Bellywise — Food & Feelings"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan product barcodes and photograph ingredient lists so Bellywise can help you log food and drinks.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Scan product barcodes and photograph ingredient lists so Bellywise can help you log food and drinks.",
          "photosPermission": "Choose an ingredient-label photo to read privately on this device.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "usePrecompiledModules": false
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/with-local-notifications-only",
      "./plugins/with-quick-log-widget",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "supportedLocales": {
            "ios": [
              "ar",
              "bn",
              "ca",
              "zh-Hans",
              "zh-Hant",
              "hr",
              "cs",
              "da",
              "nl",
              "en-AU",
              "en-CA",
              "en-GB",
              "en-US",
              "fi",
              "fr",
              "fr-CA",
              "de",
              "el",
              "gu",
              "he",
              "hi",
              "hu",
              "id",
              "it",
              "ja",
              "kn",
              "ko",
              "ms",
              "ml",
              "mr",
              "nb",
              "or",
              "pl",
              "pt-BR",
              "pt-PT",
              "pa",
              "ro",
              "ru",
              "sk",
              "sl",
              "es-MX",
              "es-ES",
              "sv",
              "ta",
              "te",
              "th",
              "tr",
              "uk",
              "ur",
              "vi"
            ]
          }
        }
      ]
    ],
    "locales": {
      "ar": "./localization/native/ar.json",
      "bn": "./localization/native/bn.json",
      "ca": "./localization/native/ca.json",
      "zh-Hans": "./localization/native/zh-Hans.json",
      "zh-Hant": "./localization/native/zh-Hant.json",
      "hr": "./localization/native/hr.json",
      "cs": "./localization/native/cs.json",
      "da": "./localization/native/da.json",
      "nl": "./localization/native/nl.json",
